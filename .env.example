# App
NEXTAUTH_URL=http://localhost:3000
# Production: NEXTAUTH_URL=https://<your-vercel-domain>
NEXTAUTH_SECRET=change-me-to-a-long-random-string-32chars-min

# Database — PostgreSQL required on Vercel (SQLite does not work on serverless).
# Local/dev: any Postgres, Neon, Prisma Postgres, or Turso-via-Prisma-compatible URL.
# Production: set DATABASE_URL in Vercel project env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Email magic link — set ONE of these for real sends:
# Option A: Resend (recommended)
# RESEND_API_KEY=re_xxxx
# EMAIL_FROM="TeAviso <avisos@tudominio.com>"

# Option B: SMTP via Nodemailer
# EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
# EMAIL_FROM="TeAviso <avisos@tudominio.com>"

# Demo mode: if neither RESEND_API_KEY nor EMAIL_SERVER is set,
# login accepts any email and creates a session without sending mail.
# Look for [DEMO AUTH] in the server console / Vercel function logs for the magic link URL.

# PriceFetcher — default: real MX (Mercado Libre API/HTML → Liverpool HTML).
# PRICE_FETCHER=mock
# USE_MOCK_PRICES=1

# ML robot
MERCADOLIBRE_ACCESS_TOKEN=
CRON_SECRET=
